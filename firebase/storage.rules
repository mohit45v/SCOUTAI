rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /players/{playerId}/{allPaths=**} {
      allow read: if true;
      // Max 10MB, image/video types only
      allow write: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
